# PostgreSQL Configuration
POSTGRES_DB=vta_dev
POSTGRES_USER=vta_user
POSTGRES_PASSWORD=vta_password

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Connection String (used by the backend services in docker-compose.yml)
# Format: Host=postgres;Port=5432;Database={POSTGRES_DB};Username={POSTGRES_USER};Password={POSTGRES_PASSWORD}

# JWT Secret (CHANGE THIS IN PRODUCTION - minimum 32 characters)
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters-long
