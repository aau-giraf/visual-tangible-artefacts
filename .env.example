# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=vta_dev
MYSQL_USER=vta_user
MYSQL_PASSWORD=vta_password

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Connection String (auto-generated from MySQL vars above in docker-compose.yml)
# Format: server=mysql;port=3306;database={MYSQL_DATABASE};user={MYSQL_USER};password={MYSQL_PASSWORD}

# JWT Secret (CHANGE THIS IN PRODUCTION - minimum 32 characters)
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters-long
