# VTA Configuration
POSTGRES_VTA_DB=vta_dev
POSTGRES_VTA_USER=vta_user
POSTGRES_VTA_PASSWORD=vta_password
POSTGRES_VTA_PORT=5432

# Dummy Core Configuration
POSTGRES_DUMMY_DB=dummy_core_offline
POSTGRES_DUMMY_USER=dummy_core_user
POSTGRES_DUMMY_PASSWORD=dummy_core_password
POSTGRES_DUMMY_PORT=5433

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Connection Strings
# Format: Server=localhost;Port=${POSTGRES_VTA_PORT};Database=${POSTGRES_VTA_DB};User Id=${POSTGRES_VTA_USER};Password=${POSTGRES_VTA_PASSWORD}
# Built from the POSTGRES_* variables above, so they must be defined first.

ConnectionStrings__VTAConnectionString=Server=localhost;Port=${POSTGRES_VTA_PORT};Database=${POSTGRES_VTA_DB};User Id=${POSTGRES_VTA_USER};Password=${POSTGRES_VTA_PASSWORD}
ConnectionStrings__DummyCoreConnectionString=Server=localhost;Port=${POSTGRES_DUMMY_PORT};Database=${POSTGRES_DUMMY_DB};User Id=${POSTGRES_DUMMY_USER};Password=${POSTGRES_DUMMY_PASSWORD}


# JWT Secret (CHANGE THIS IN PRODUCTION - minimum 32 characters)
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters-long